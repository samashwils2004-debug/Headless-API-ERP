{
  "name": "admitflow-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names API,WEB --prefix-colors cyan,green \"npm run api:dev\" \"npm run web:dev\"",
    "api:dev": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir apps/api --reload",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:type-check": "npm --prefix apps/web run type-check",
    "api:test": "python -m pytest apps/api/tests",
    "api:seed": "python apps/api/seed_demo.py"
  },
  "dependencies": {
    "@google/stitch-sdk": "^0.3.5",
    "tar": "^7.5.16"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
